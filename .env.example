# Copy this file to .env on the server and chmod 600 .env.
# Never commit the real file: TS_AUTHKEY is a secret.

# Full MagicDNS hostname for the Caddy Tailscale node.
TS_FQDN=affine.<your-tailnet>.ts.net

# Reusable or tagged Tailscale auth key allowed by the tailnet ACL.
TS_AUTHKEY=tskey-auth-replace-me

# Keep the official stable image by default. Pin this to a reviewed release
# before a production upgrade.
AFFINE_IMAGE=ghcr.io/toeverything/affine:stable
